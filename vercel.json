{
  "builds": [
    {
      "src": "shopsite/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "public/**",
          "shop.db"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "shopsite/wsgi.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "shopsite/wsgi.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
